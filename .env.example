# Copy to .env and fill in. Never commit .env.
# OpenAI is used ONLY to resolve an institution's official/former names when it does not match the official
# lists directly. Accreditation itself is always decided from the official UGC / AICTE lists.
OPENAI_API_KEY=
# ARA_OPENAI_MODEL=gpt-5.4-mini
# ARA_DISABLE_LLM=1                 # direct matching only, no OpenAI calls
# ARA_DATA_DIR=./data               # cache (official lists), reports (proof PDFs + JSON), audit log
# ARA_AICTE_LIST_URL=https://aicte.gov.in/sites/default/files/approval/2025-26/Groupwise-List%20of%20Institutions_compressed.pdf
# ARA_AICTE_NOTICE_URL=https://www.aicte.gov.in/sites/default/files/approval/2025-26/Public%20Notice%202025-26.pdf
# ARA_AICTE_SESSION=2025-26
# ARA_UGC_MAX_AGE_DAYS=7
# ARA_AICTE_MAX_AGE_DAYS=30
# ARA_BROWSER_CHANNEL=chrome        # "" → Playwright's bundled Chromium (run: playwright install chromium)
# ARA_MAX_BROWSER_PAGES=4
# ARA_LIVE_UGC_SCREENSHOTS=1        # 0 → no live ugc.gov.in captures (record text only)
# ARA_API_KEYS=                     # comma-separated; when set, /v1 calls need header X-API-Key
# ARA_CORS_ORIGINS=                 # comma-separated origins allowed to call the API from a browser
# ARA_PUBLIC_BASE_URL=              # e.g. https://ara.example.com → absolute proof URLs in responses
